import wollok.game.*
import juego.*
import cancion.*

describe "el recorrido entre pantallas" {

	method initialize() {
		game.width(12)
		game.height(14)
		game.flushEvents(0)
		juego.pantalla(menu)
		juego.empezar()
	}

	test "arranca en el menu" {
		assert.equals(menu, juego.pantalla())
	}

	test "ENTER en el menu empieza a jugar" {
		juego.confirmar()
		assert.equals(jugando, juego.pantalla())
	}

	test "la tecla de tocar en el menu no hace nada" {
		juego.tocar()
		assert.equals(menu, juego.pantalla())
	}

	test "cuando se termina la cancion se pasa al resultado" {
		juego.confirmar()
		game.flushEvents(cancionDeEjemplo.duracion())
		juego.actualizar()
		assert.equals(resultado, juego.pantalla())
	}

	test "ENTER en el resultado vuelve al menu" {
		juego.confirmar()
		game.flushEvents(cancionDeEjemplo.duracion())
		juego.actualizar()
		juego.confirmar()
		assert.equals(menu, juego.pantalla())
	}

}
