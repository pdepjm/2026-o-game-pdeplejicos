import wollok.game.*
import juego.*
import pista.*

program jugar {

	game.title("Wollok Hero")
	game.width(15)
	game.height(10)
	game.cellSize(50)
	game.boardGround("fondo_luz.png")

	// Las teclas se registran una sola vez: que hacer con ellas lo decide
	// la pantalla que este activa
	keyboard.enter().onPressDo({ juego.confirmar() })

	// Una tecla por carril. Arriba y abajo ademas mueven la seleccion del menu:
	// cada pantalla atiende el mensaje que le importa y deja pasar el otro
	keyboard.left().onPressDo({
		juego.anterior()
		juego.tocar(carrilIzquierda)
	})
	keyboard.down().onPressDo({
		juego.bajar()
		juego.tocar(carrilAbajo)
	})
	keyboard.up().onPressDo({
		juego.subir()
		juego.tocar(carrilArriba)
	})
	keyboard.right().onPressDo({
		juego.siguiente()
		juego.tocar(carrilDerecha)
	})

	keyboard.left().onReleaseDo({ juego.soltar(carrilIzquierda) })
	keyboard.down().onReleaseDo({ juego.soltar(carrilAbajo) })
	keyboard.up().onReleaseDo({ juego.soltar(carrilArriba) })
	keyboard.right().onReleaseDo({ juego.soltar(carrilDerecha) })

	game.onTick(50, "actualizarJuego", { juego.actualizar() })

	juego.empezar()
	game.start()

}
